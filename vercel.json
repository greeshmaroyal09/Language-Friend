{
    "headers": [
        { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
        { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
        { "source": "/human", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
        { "source": "/ai", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
        { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
    ],
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "https://backend-orcin-kappa-81.vercel.app/api/:path*"
        },
        {
            "source": "/human",
            "destination": "/index.html"
        },
        {
            "source": "/ai",
            "destination": "/index.html"
        }
    ]
}
